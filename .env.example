# Adaptateur visuel sélectionné: mock | null | jarvis-readonly
VISUAL_ADAPTER=mock

# Le connecteur JARVIS reste fermé tant que cette valeur n'est pas exactement true.
JARVIS_CONNECTOR_ENABLED=false

# Origine HTTP(S) du serveur JARVIS. Aucune valeur par défaut n'est injectée.
# Exemple: https://jarvis.example.internal
JARVIS_ORIGIN=

# Préférences navigateur minimales. false évite toute persistance locale.
VISUAL_BROWSER_PERSISTENCE=false

# Écoute locale configurable de Claw3D.
CLAW3D_HOST=127.0.0.1
CLAW3D_PORT=3000
